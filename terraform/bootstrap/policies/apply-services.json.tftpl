{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ElbCreateProjectTagged", "Effect": "Allow",
     "Action": ["elasticloadbalancing:CreateLoadBalancer", "elasticloadbalancing:CreateTargetGroup"],
     "Resource": [
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${project}-*/*",
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:targetgroup/${project}-*/*"],
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "ElbManageProjectResources", "Effect": "Allow",
     "Action": [
       "elasticloadbalancing:AddTags", "elasticloadbalancing:RemoveTags",
       "elasticloadbalancing:ModifyLoadBalancerAttributes", "elasticloadbalancing:SetSecurityGroups",
       "elasticloadbalancing:SetSubnets", "elasticloadbalancing:DeleteLoadBalancer",
       "elasticloadbalancing:ModifyTargetGroup", "elasticloadbalancing:ModifyTargetGroupAttributes",
       "elasticloadbalancing:DeleteTargetGroup", "elasticloadbalancing:RegisterTargets",
       "elasticloadbalancing:DeregisterTargets", "elasticloadbalancing:CreateListener",
       "elasticloadbalancing:ModifyListener", "elasticloadbalancing:ModifyListenerAttributes",
       "elasticloadbalancing:DeleteListener", "elasticloadbalancing:CreateRule",
       "elasticloadbalancing:ModifyRule", "elasticloadbalancing:DeleteRule",
       "elasticloadbalancing:SetRulePriorities"],
     "Resource": [
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${project}-*/*",
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener/app/${project}-*/*",
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener-rule/app/${project}-*/*",
       "arn:${partition}:elasticloadbalancing:${region}:${account_id}:targetgroup/${project}-*/*"]},
    {"Sid": "EcsCreateProjectTagged", "Effect": "Allow",
     "Action": ["ecs:CreateCluster", "ecs:RegisterTaskDefinition", "ecs:CreateService"],
     "Resource": [
       "arn:${partition}:ecs:${region}:${account_id}:cluster/${project}-*",
       "arn:${partition}:ecs:${region}:${account_id}:task-definition/${project}-*:*",
       "arn:${partition}:ecs:${region}:${account_id}:service/${project}-*/${project}-*"],
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "EcsManageProjectResources", "Effect": "Allow",
     "Action": ["ecs:DeleteCluster", "ecs:UpdateCluster", "ecs:UpdateClusterSettings", "ecs:PutClusterCapacityProviders",
                "ecs:UpdateService", "ecs:DeleteService", "ecs:TagResource", "ecs:UntagResource"],
     "Resource": [
       "arn:${partition}:ecs:${region}:${account_id}:cluster/${project}-*",
       "arn:${partition}:ecs:${region}:${account_id}:task-definition/${project}-*:*",
       "arn:${partition}:ecs:${region}:${account_id}:service/${project}-*/${project}-*"]},
    {"Sid": "EcsDeregisterTaskDefinitionNoResourceLevel", "Effect": "Allow",
     "Action": "ecs:DeregisterTaskDefinition", "Resource": "*"},
    {"Sid": "AppAutoScalingEcsServiceDesiredCountOnly", "Effect": "Allow",
     "Action": ["application-autoscaling:RegisterScalableTarget", "application-autoscaling:DeregisterScalableTarget",
                "application-autoscaling:PutScalingPolicy", "application-autoscaling:DeleteScalingPolicy"],
     "Resource": "arn:${partition}:application-autoscaling:${region}:${account_id}:scalable-target/*",
     "Condition": {"StringEquals": {"application-autoscaling:service-namespace": "ecs",
                                    "application-autoscaling:scalable-dimension": "ecs:service:DesiredCount"}}},
    {"Sid": "AppAutoScalingTags", "Effect": "Allow",
     "Action": ["application-autoscaling:TagResource", "application-autoscaling:UntagResource"],
     "Resource": "arn:${partition}:application-autoscaling:${region}:${account_id}:scalable-target/*"},
    {"Sid": "CloudWatchProjectAlarmsWithProjectActionsOnly", "Effect": "Allow", "Action": "cloudwatch:PutMetricAlarm",
     "Resource": [
       "arn:${partition}:cloudwatch:${region}:${account_id}:alarm:${project}-*",
       "arn:${partition}:cloudwatch:${region}:${account_id}:alarm:TargetTracking-service/${project}-*"],
     "Condition": {"ForAllValues:StringLike": {"cloudwatch:AlarmActions": [
       "arn:${partition}:sns:${region}:${account_id}:${project}-*",
       "arn:${partition}:autoscaling:${region}:${account_id}:scalingPolicy:*"]}}},
    {"Sid": "CloudWatchManageProjectAlarmsAndDashboards", "Effect": "Allow",
     "Action": ["cloudwatch:DeleteAlarms", "cloudwatch:TagResource", "cloudwatch:UntagResource",
                "cloudwatch:PutDashboard", "cloudwatch:DeleteDashboards"],
     "Resource": [
       "arn:${partition}:cloudwatch:${region}:${account_id}:alarm:${project}-*",
       "arn:${partition}:cloudwatch:${region}:${account_id}:alarm:TargetTracking-service/${project}-*",
       "arn:${partition}:cloudwatch::${account_id}:dashboard/${project}-*"]},
    {"Sid": "LogsCreateProjectGroupsTagged", "Effect": "Allow", "Action": "logs:CreateLogGroup",
     "Resource": [
       "arn:${partition}:logs:${region}:${account_id}:log-group:/ecs/${project}-*",
       "arn:${partition}:logs:${region}:${account_id}:log-group:/vpc/${project}-*"],
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "LogsManageProjectGroups", "Effect": "Allow",
     "Action": ["logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:DeleteRetentionPolicy",
                "logs:TagResource", "logs:UntagResource", "logs:TagLogGroup", "logs:UntagLogGroup"],
     "Resource": [
       "arn:${partition}:logs:${region}:${account_id}:log-group:/ecs/${project}-*",
       "arn:${partition}:logs:${region}:${account_id}:log-group:/vpc/${project}-*"]},
    {"Sid": "SnsCreateProjectTopicTagged", "Effect": "Allow", "Action": "sns:CreateTopic",
     "Resource": "arn:${partition}:sns:${region}:${account_id}:${project}-*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "SnsManageProjectTopic", "Effect": "Allow",
     "Action": ["sns:DeleteTopic", "sns:SetTopicAttributes", "sns:GetTopicAttributes", "sns:Unsubscribe",
                "sns:TagResource", "sns:UntagResource", "sns:GetSubscriptionAttributes",
                "sns:SetSubscriptionAttributes"],
     "Resource": "arn:${partition}:sns:${region}:${account_id}:${project}-*"},
    {"Sid": "SnsEmailSubscriptionsOnly", "Effect": "Allow", "Action": "sns:Subscribe",
     "Resource": "arn:${partition}:sns:${region}:${account_id}:${project}-*",
     "Condition": {"StringEquals": {"sns:Protocol": "email"}}}
  ]
}
