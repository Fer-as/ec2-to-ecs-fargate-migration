{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Ec2CreateVpcTagged", "Effect": "Allow", "Action": "ec2:CreateVpc",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:vpc/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2CreateSubnetTagged", "Effect": "Allow", "Action": "ec2:CreateSubnet",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:subnet/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2CreateRouteTableTagged", "Effect": "Allow", "Action": "ec2:CreateRouteTable",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:route-table/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2CreateSecurityGroupTagged", "Effect": "Allow", "Action": "ec2:CreateSecurityGroup",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:security-group/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2AllocateAddressTagged", "Effect": "Allow", "Action": "ec2:AllocateAddress",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:elastic-ip/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2CreateLeafResourcesTagged", "Effect": "Allow",
     "Action": ["ec2:CreateInternetGateway", "ec2:CreateNatGateway", "ec2:CreateVpcEndpoint", "ec2:CreateFlowLogs"],
     "Resource": [
       "arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*",
       "arn:${partition}:ec2:${region}:${account_id}:natgateway/*",
       "arn:${partition}:ec2:${region}:${account_id}:vpc-endpoint/*",
       "arn:${partition}:ec2:${region}:${account_id}:vpc-flow-log/*"],
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2RunLegacyInstanceOnly", "Effect": "Allow", "Action": "ec2:RunInstances",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:instance/*",
     "Condition": {"StringEquals": {"aws:RequestTag/Project": "${project}",
                                    "ec2:InstanceType": "${legacy_instance_type}",
                                    "ec2:MetadataHttpTokens": "required"}}},
    {"Sid": "Ec2RunFromCanonicalUbuntuOnly", "Effect": "Allow", "Action": "ec2:RunInstances",
     "Resource": ["arn:${partition}:ec2:${region}::image/*", "arn:${partition}:ec2:${region}::snapshot/*"],
     "Condition": {"StringEquals": {"ec2:Owner": ["${ami_owner}", "amazon"]}}},
    {"Sid": "Ec2ChildResourcesOfCheckedParents", "Effect": "Allow",
     "Action": ["ec2:RunInstances", "ec2:AssociateAddress", "ec2:DisassociateAddress", "ec2:ModifyInstanceAttribute",
                "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:ModifySecurityGroupRules"],
     "Resource": [
       "arn:${partition}:ec2:${region}:${account_id}:volume/*",
       "arn:${partition}:ec2:${region}:${account_id}:network-interface/*",
       "arn:${partition}:ec2:${region}:${account_id}:security-group-rule/*"]},
    {"Sid": "Ec2ManageProjectTaggedResources", "Effect": "Allow",
     "Action": [
       "ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup", "ec2:CreateNatGateway",
       "ec2:CreateVpcEndpoint", "ec2:CreateFlowLogs", "ec2:RunInstances",
       "ec2:ModifyVpcAttribute", "ec2:DeleteVpc", "ec2:ModifySubnetAttribute", "ec2:DeleteSubnet",
       "ec2:AttachInternetGateway", "ec2:DetachInternetGateway", "ec2:DeleteInternetGateway",
       "ec2:CreateRoute", "ec2:ReplaceRoute", "ec2:DeleteRoute", "ec2:AssociateRouteTable",
       "ec2:DisassociateRouteTable", "ec2:DeleteRouteTable",
       "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupIngress",
       "ec2:RevokeSecurityGroupEgress", "ec2:ModifySecurityGroupRules", "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
       "ec2:UpdateSecurityGroupRuleDescriptionsEgress", "ec2:DeleteSecurityGroup",
       "ec2:AssociateAddress", "ec2:DisassociateAddress", "ec2:ReleaseAddress", "ec2:DeleteNatGateway",
       "ec2:ModifyVpcEndpoint", "ec2:DeleteVpcEndpoints", "ec2:DeleteFlowLogs",
       "ec2:TerminateInstances", "ec2:StopInstances", "ec2:StartInstances", "ec2:ModifyInstanceAttribute",
       "ec2:ModifyInstanceMetadataOptions", "ec2:AssociateIamInstanceProfile",
       "ec2:ReplaceIamInstanceProfileAssociation", "ec2:DisassociateIamInstanceProfile",
       "ec2:MonitorInstances", "ec2:UnmonitorInstances"],
     "Resource": [
       "arn:${partition}:ec2:${region}:${account_id}:vpc/*",
       "arn:${partition}:ec2:${region}:${account_id}:subnet/*",
       "arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*",
       "arn:${partition}:ec2:${region}:${account_id}:route-table/*",
       "arn:${partition}:ec2:${region}:${account_id}:security-group/*",
       "arn:${partition}:ec2:${region}:${account_id}:elastic-ip/*",
       "arn:${partition}:ec2:${region}:${account_id}:natgateway/*",
       "arn:${partition}:ec2:${region}:${account_id}:vpc-endpoint/*",
       "arn:${partition}:ec2:${region}:${account_id}:vpc-flow-log/*",
       "arn:${partition}:ec2:${region}:${account_id}:instance/*"],
     "Condition": {"StringEquals": {"aws:ResourceTag/Project": "${project}"}}},
    {"Sid": "Ec2TagOnCreate", "Effect": "Allow", "Action": "ec2:CreateTags",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:*/*",
     "Condition": {"StringEquals": {"ec2:CreateAction": [
       "CreateVpc", "CreateSubnet", "CreateInternetGateway", "CreateRouteTable", "CreateSecurityGroup",
       "AllocateAddress", "CreateNatGateway", "CreateVpcEndpoint", "CreateFlowLogs", "RunInstances",
       "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress"]}}},
    {"Sid": "Ec2RetagProjectResources", "Effect": "Allow", "Action": "ec2:CreateTags",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:*/*",
     "Condition": {"StringEquals": {"aws:ResourceTag/Project": "${project}"},
                   "StringEqualsIfExists": {"aws:RequestTag/Project": "${project}"}}},
    {"Sid": "Ec2UntagProjectResourcesKeepProjectTag", "Effect": "Allow", "Action": "ec2:DeleteTags",
     "Resource": "arn:${partition}:ec2:${region}:${account_id}:*/*",
     "Condition": {"StringEquals": {"aws:ResourceTag/Project": "${project}"},
                   "Null": {"aws:TagKeys": "false"},
                   "ForAllValues:StringNotEquals": {"aws:TagKeys": ["Project"]}}}
  ]
}
