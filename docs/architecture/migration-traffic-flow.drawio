        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;fontFamily=Helvetica;" edge="1" parent="1" source="c46" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c49" value="Bars: orange = EC2 target group weight, purple = ECS target group weight. Terraform preconditions refuse stage &gt; 0 unless the ECS service exists and EC2 uses DynamoDB.&lt;br&gt;Verified 28 Oct 2026: stage 1 (90/10), stage 2 (50/50), stage 3 (0/100), rollback to stage 0 and restoration to stage 3 all PASS, each after a 15-minute monitored hold." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=none;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="c29"><mxGeometry x="15" y="205" width="700" height="50" as="geometry"/></mxCell>
        <mxCell id="c50" value="shared state confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2DA44E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Helvetica;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="478"/><mxPoint x="185" y="478"/></Array></mxGeometry></mxCell>
        <mxCell id="c51" value="4. Rollback (any stage → Stage 0)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#DD344C;fillColor=#FFF8F9;verticalAlign=top;align=left;spacingLeft=30;fontColor=#DD344C;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="820" height="200" as="geometry"/></mxCell>
        <mxCell id="c52" value="PR: traffic_stage = 0 → platform deploy → approval&lt;br&gt;Listener weights change; ECS also rolls the rebuilt image (apply about 3 min).&lt;br&gt;No data copy: EC2 and ECS share one DynamoDB table.&lt;br&gt;EC2 stays registered (weight 0) until the rollback window ends.&lt;br&gt;Tested: 100 % ECS → 100 % EC2 → 100 % ECS, all PASS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="c51"><mxGeometry x="15" y="45" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="c53" value="Bad image: ECS deployment circuit breaker rolls back automatically.&lt;br&gt;Pipeline unavailable: admin sets weights in the console, then commits the same traffic_stage.&lt;br&gt;Never roll back to the in-memory build (would lose shared orders)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="c51"><mxGeometry x="415" y="45" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="c54" value="5. Monitoring and failure response" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#E7157B;fillColor=#FFF7FB;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="780" width="880" height="200" as="geometry"/></mxCell>
        <mxCell id="c55" value="CloudWatch alarms → SNS: ALB 5xx, ECS target 5xx,&lt;br&gt;unhealthy targets, ECS CPU high, tasks below desired.&lt;br&gt;Dashboard: legacy-api-production-migration&lt;br&gt;(traffic split, target health, 5xx, CPU)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E7157B;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="c54"><mxGeometry x="15" y="45" width="410" height="140" as="geometry"/></mxCell>
        <mxCell id="c56" value="STOP the rollout on: alarm in ALARM, unhealthy targets,&lt;br&gt;/ready ≠ 200, EC2 vs ECS data mismatch, AccessDenied,&lt;br&gt;unexpected replacement/deletion in the plan.&lt;br&gt;Then roll back to Stage 0 and investigate." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF0F2;strokeColor=#DD344C;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="c54"><mxGeometry x="440" y="45" width="425" height="140" as="geometry"/></mxCell>
